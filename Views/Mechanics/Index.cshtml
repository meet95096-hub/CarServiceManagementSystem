@model IEnumerable<web.net.Models.Mechanic>
@{
    ViewData["Title"] = "Workshop Bays & Technicians";
    var packages = ViewBag.Packages as List<web.net.Models.ServicePackage> ?? new List<web.net.Models.ServicePackage>();
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="mb-1" style="font-size: 26px; font-weight: 800;">Workshop Bays & Master Technicians</h1>
            <p class="text-secondary mb-0" style="font-size: 14px;">Technician roster, bay hoists, specialization assignments, and standard service package catalog.</p>
        </div>
    </div>

    <!-- Technicians Roster Cards -->
    <div class="row g-4">
        @foreach (var mechanic in Model)
        {
            var activeJob = mechanic.LeadJobs.FirstOrDefault();
            <div class="col-12 col-md-6 col-xl-3">
                <div class="glass-card h-100 p-4 d-flex flex-column justify-content-between position-relative">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div style="width: 52px; height: 52px; border-radius: 14px; background: linear-gradient(135deg, #0ea5e9, #3b82f6); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #fff;">
                                @mechanic.AvatarInitials
                            </div>
                            <span class="badge @(mechanic.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(mechanic.IsAvailable ? "Active Duty" : "Off Shift")
                            </span>
                        </div>

                        <h5 class="fw-bold text-white mb-1">@mechanic.FullName</h5>
                        <div class="text-info mb-2" style="font-size: 13px; font-weight: 600;">@mechanic.Specialization</div>

                        <div class="p-2 rounded mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); font-size: 12px;">
                            <div class="text-muted" style="font-size: 11px;">Assigned Hoist / Bay:</div>
                            <div class="fw-bold text-white">@mechanic.AssignedBay</div>
                        </div>

                        <div class="d-flex flex-column gap-1 text-secondary" style="font-size: 12px;">
                            <div><i class="bi bi-telephone text-primary me-2"></i>@mechanic.Phone</div>
                            <div><i class="bi bi-envelope text-primary me-2"></i>@mechanic.Email</div>
                            <div><i class="bi bi-award text-warning me-2"></i>@mechanic.ExperienceYears years master experience</div>
                        </div>
                    </div>

                    <div class="pt-3 border-top border-secondary mt-3">
                        @if (activeJob != null && activeJob.Vehicle != null)
                        {
                            <div class="p-2 rounded mb-2" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3);">
                                <div class="text-warning fw-bold" style="font-size: 11px;">Current Active Hoist:</div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="plate-tag" style="font-size: 10px; padding: 1px 5px;">@activeJob.Vehicle.LicensePlate</span>
                                    <a asp-controller="RepairTracking" asp-action="Details" asp-route-id="@activeJob.Id" class="text-info text-decoration-none" style="font-size: 11px;">
                                        Job Details &rarr;
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted fst-italic mb-2" style="font-size: 11px;">No vehicle currently in bay.</div>
                        }

                        <form asp-action="ToggleAvailability" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@mechanic.Id" />
                            <button type="submit" class="btn-apex btn-apex-secondary w-100 justify-content-center" style="padding: 6px 12px; font-size: 12px;">
                                <i class="bi bi-arrow-repeat"></i>
                                <span>Toggle Duty Status</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Standard Service Packages Catalogue -->
    <div class="glass-card">
        <div class="card-header-custom">
            <div class="card-header-title">
                <i class="bi bi-journal-bookmark-fill text-warning"></i>
                <span>Standardized Service Packages Catalog (@packages.Count)</span>
            </div>
            <a asp-controller="Appointments" asp-action="Create" class="btn-apex btn-apex-primary" style="padding: 6px 12px; font-size: 12px;">
                <i class="bi bi-calendar-plus"></i>
                <span>Book Service With Package</span>
            </a>
        </div>
        <div class="p-0">
            <div class="table-responsive">
                <table class="table-apex">
                    <thead>
                        <tr>
                            <th>Service Package</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Duration</th>
                            <th class="text-end">Base Labor Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pkg in packages)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-white fs-6">
                                        <i class="bi @pkg.IconClass text-info me-2"></i>@pkg.Name
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8;">
                                        @pkg.Category
                                    </span>
                                </td>
                                <td class="text-secondary" style="max-width: 320px; font-size: 13px;">
                                    @pkg.Description
                                </td>
                                <td>
                                    <div class="text-white">@pkg.EstimatedHours.ToString("0.0") hrs</div>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-success fs-6">$@pkg.BaseLaborPrice.ToString("N2")</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
