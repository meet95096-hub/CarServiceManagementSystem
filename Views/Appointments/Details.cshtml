@model web.net.Models.ServiceAppointment
@{
    ViewData["Title"] = $"Appointment {Model.AppointmentCode}";
}

<div class="d-flex flex-column gap-4" style="max-width: 1000px; margin: 0 auto;">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-secondary" style="font-size: 13px;">
                    <i class="bi bi-arrow-left me-1"></i> Appointments
                </a>
                <span class="text-muted">/</span>
                <span class="text-muted" style="font-size: 13px;">Booking Details</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="mb-0" style="font-size: 26px; font-weight: 800; font-family: var(--font-mono); color: #38bdf8;">
                    @Model.AppointmentCode
                </h1>
                <span class="badge @(Model.Status == web.net.Models.AppointmentStatus.InService ? "bg-warning text-dark" : Model.Status == web.net.Models.AppointmentStatus.Completed ? "bg-success" : Model.Status == web.net.Models.AppointmentStatus.Confirmed ? "bg-primary" : "bg-info text-dark") fs-6 px-3 py-2">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (!Model.LinkedRepairJobId.HasValue && Model.Status != web.net.Models.AppointmentStatus.Cancelled)
            {
                <form asp-action="ConvertToJobCard" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-apex btn-apex-amber">
                        <i class="bi bi-tools"></i>
                        <span>Start Repair (Convert to Job Card)</span>
                    </button>
                </form>
            }
            else if (Model.LinkedRepairJobId.HasValue)
            {
                <a asp-controller="RepairTracking" asp-action="Details" asp-route-id="@Model.LinkedRepairJobId" class="btn-apex btn-apex-primary">
                    <i class="bi bi-wrench-adjustable"></i>
                    <span>Open Linked Job Card</span>
                </a>
            }
        </div>
    </div>

    <!-- Booking Overview Grid -->
    <div class="row g-4">
        <!-- Appointment Info -->
        <div class="col-12 col-lg-7">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <div class="card-header-title">
                        <i class="bi bi-calendar3 text-warning"></i>
                        <span>Service Requirement & Time Slot</span>
                    </div>
                </div>
                <div class="card-body-custom">
                    <h4 class="text-white mb-2">@Model.ServiceTitle</h4>
                    @if (Model.ServicePackage != null)
                    {
                        <div class="badge mb-3" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8;">
                            Package: @Model.ServicePackage.Name
                        </div>
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Scheduled Date</div>
                            <div class="fw-bold text-white fs-6">@Model.ScheduledDate.ToString("dddd, MMMM dd, yyyy")</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Time Slot</div>
                            <div class="fw-bold text-white fs-6">@Model.TimeSlot</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Assigned Bay</div>
                            <div class="fw-bold text-info fs-6">@Model.Bay</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Lead Mechanic</div>
                            <div class="fw-bold text-white fs-6">@(Model.Mechanic?.FullName ?? "Unassigned")</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Estimated Cost</div>
                            <div class="fw-bold text-success fs-5">$@Model.EstimatedCost.ToString("F2")</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Booked On</div>
                            <div class="text-secondary" style="font-size: 13px;">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CustomerNotes))
                    {
                        <div class="mt-4 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle);">
                            <div class="text-muted mb-1" style="font-size: 11px; text-transform: uppercase;">Client Symptoms / Special Requests</div>
                            <div class="text-white" style="font-size: 14px;">@Model.CustomerNotes</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Vehicle & Client Info -->
        <div class="col-12 col-lg-5">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <div class="card-header-title">
                        <i class="bi bi-car-front-fill text-info"></i>
                        <span>Client & Vehicle</span>
                    </div>
                    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn-apex btn-apex-secondary" style="padding: 4px 10px; font-size: 11px;">
                        Full Profile
                    </a>
                </div>
                <div class="card-body-custom">
                    @if (Model.Vehicle != null)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="plate-tag accent fs-6">@Model.Vehicle.LicensePlate</span>
                            <div>
                                <div class="fw-bold text-white fs-6">@Model.Vehicle.Year @Model.Vehicle.Make @Model.Vehicle.Model</div>
                                <div class="text-muted" style="font-size: 12px;">Color: @Model.Vehicle.Color &bull; Odometer: @Model.Vehicle.CurrentMileage.ToString("N0") km</div>
                            </div>
                        </div>

                        <hr style="border-color: var(--border-subtle);" />

                        <div class="d-flex flex-column gap-3">
                            <div>
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Owner Name</div>
                                <div class="fw-bold text-white">@Model.Vehicle.OwnerName</div>
                            </div>
                            <div>
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Contact Phone</div>
                                <div class="text-white"><i class="bi bi-telephone text-primary me-2"></i>@Model.Vehicle.OwnerPhone</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Vehicle.OwnerEmail))
                            {
                                <div>
                                    <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Email</div>
                                    <div class="text-white"><i class="bi bi-envelope text-primary me-2"></i>@Model.Vehicle.OwnerEmail</div>
                                </div>
                            }
                        </div>
                    }

                    <hr style="border-color: var(--border-subtle);" class="my-3" />

                    <!-- Update Status Form -->
                    <form asp-action="UpdateStatus" method="post" class="d-flex flex-column gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label-custom mb-1">Update Appointment Status:</label>
                        <div class="d-flex gap-2">
                            <select name="status" class="form-select-custom flex-grow-1">
                                <option value="Scheduled" selected="@(Model.Status == web.net.Models.AppointmentStatus.Scheduled)">Scheduled</option>
                                <option value="Confirmed" selected="@(Model.Status == web.net.Models.AppointmentStatus.Confirmed)">Confirmed</option>
                                <option value="InService" selected="@(Model.Status == web.net.Models.AppointmentStatus.InService)">In Service</option>
                                <option value="Completed" selected="@(Model.Status == web.net.Models.AppointmentStatus.Completed)">Completed</option>
                                <option value="Cancelled" selected="@(Model.Status == web.net.Models.AppointmentStatus.Cancelled)">Cancelled</option>
                            </select>
                            <button type="submit" class="btn-apex btn-apex-primary" style="padding: 6px 14px; font-size: 12px;">
                                Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
