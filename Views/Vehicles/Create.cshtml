@model web.net.Models.Vehicle
@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="d-flex flex-column gap-4" style="max-width: 900px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div>
        <a asp-action="Index" class="text-secondary" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> Back to Vehicle Registry
        </a>
        <h1 class="mt-2 mb-1" style="font-size: 26px; font-weight: 800;">Register New Client Vehicle</h1>
        <p class="text-secondary mb-0" style="font-size: 14px;">Enter vehicle identification, technical specs, and owner contact details.</p>
    </div>

    <div class="glass-card">
        <form asp-action="Create" method="post" class="card-body-custom">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="text-info mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-car-front-fill"></i>
                <span>Vehicle Identification & Specifications</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="LicensePlate" class="form-label-custom"></label>
                    <input asp-for="LicensePlate" class="form-control-custom text-uppercase" placeholder="e.g. CAL-7892, NY-4019" autofocus />
                    <span asp-validation-for="LicensePlate" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Make" class="form-label-custom"></label>
                    <input asp-for="Make" class="form-control-custom" placeholder="e.g. BMW, Toyota, Porsche, Ford" />
                    <span asp-validation-for="Make" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Model" class="form-label-custom"></label>
                    <input asp-for="Model" class="form-control-custom" placeholder="e.g. 330i M Sport, RAV4, Mustang GT" />
                    <span asp-validation-for="Model" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Year" class="form-label-custom"></label>
                    <input asp-for="Year" type="number" class="form-control-custom" />
                    <span asp-validation-for="Year" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Color" class="form-label-custom"></label>
                    <input asp-for="Color" class="form-control-custom" placeholder="e.g. Alpine White, Metallic Gray" />
                    <span asp-validation-for="Color" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="FuelType" class="form-label-custom"></label>
                    <select asp-for="FuelType" class="form-select-custom">
                        <option value="Gasoline">Gasoline / Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Electric">Electric (EV)</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Transmission" class="form-label-custom"></label>
                    <select asp-for="Transmission" class="form-select-custom">
                        <option value="Automatic">Automatic</option>
                        <option value="Manual">Manual</option>
                        <option value="Dual-Clutch">Dual-Clutch / DSG</option>
                        <option value="eCVT">CVT / eCVT</option>
                    </select>
                </div>

                <div class="col-12 col-md-8">
                    <label asp-for="Vin" class="form-label-custom"></label>
                    <input asp-for="Vin" class="form-control-custom text-uppercase" placeholder="17-character VIN number (e.g. WBA5R1C50NFP84210)" />
                    <span asp-validation-for="Vin" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CurrentMileage" class="form-label-custom"></label>
                    <div class="input-group">
                        <input asp-for="CurrentMileage" type="number" class="form-control-custom" placeholder="e.g. 45000" />
                        <span class="input-group-text border-0" style="background-color: var(--bg-surface); color: var(--text-muted);">km</span>
                    </div>
                    <span asp-validation-for="CurrentMileage" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <hr style="border-color: var(--border-subtle);" class="my-4" />

            <h5 class="text-info mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person-circle"></i>
                <span>Client & Billing Profile</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="OwnerName" class="form-label-custom"></label>
                    <input asp-for="OwnerName" class="form-control-custom" placeholder="Customer full name" />
                    <span asp-validation-for="OwnerName" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerPhone" class="form-label-custom"></label>
                    <input asp-for="OwnerPhone" class="form-control-custom" placeholder="+1 (555) 000-0000" />
                    <span asp-validation-for="OwnerPhone" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerEmail" class="form-label-custom"></label>
                    <input asp-for="OwnerEmail" type="email" class="form-control-custom" placeholder="customer@domain.com" />
                    <span asp-validation-for="OwnerEmail" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerAddress" class="form-label-custom"></label>
                    <input asp-for="OwnerAddress" class="form-control-custom" placeholder="Billing & residential address" />
                    <span asp-validation-for="OwnerAddress" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                <a asp-action="Index" class="btn-apex btn-apex-secondary">Cancel</a>
                <button type="submit" class="btn-apex btn-apex-primary px-4">
                    <i class="bi bi-check-lg"></i>
                    <span>Register Vehicle</span>
                </button>
            </div>
        </form>
    </div>
</div>
