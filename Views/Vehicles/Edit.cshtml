@model web.net.Models.Vehicle
@{
    ViewData["Title"] = $"Edit {Model.LicensePlate}";
}

<div class="d-flex flex-column gap-4" style="max-width: 900px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-secondary" style="font-size: 13px;">
            <i class="bi bi-arrow-left me-1"></i> Back to Vehicle Details
        </a>
        <h1 class="mt-2 mb-1" style="font-size: 26px; font-weight: 800;">Edit Vehicle: @Model.LicensePlate</h1>
        <p class="text-secondary mb-0" style="font-size: 14px;">Update vehicle specifications and customer contact profile.</p>
    </div>

    <div class="glass-card">
        <form asp-action="Edit" method="post" class="card-body-custom">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RegisteredAt" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="text-info mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-car-front-fill"></i>
                <span>Vehicle Specifications</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="LicensePlate" class="form-label-custom"></label>
                    <input asp-for="LicensePlate" class="form-control-custom text-uppercase" />
                    <span asp-validation-for="LicensePlate" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Make" class="form-label-custom"></label>
                    <input asp-for="Make" class="form-control-custom" />
                    <span asp-validation-for="Make" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Model" class="form-label-custom"></label>
                    <input asp-for="Model" class="form-control-custom" />
                    <span asp-validation-for="Model" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Year" class="form-label-custom"></label>
                    <input asp-for="Year" type="number" class="form-control-custom" />
                    <span asp-validation-for="Year" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Color" class="form-label-custom"></label>
                    <input asp-for="Color" class="form-control-custom" />
                    <span asp-validation-for="Color" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="FuelType" class="form-label-custom"></label>
                    <select asp-for="FuelType" class="form-select-custom">
                        <option value="Gasoline">Gasoline / Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Electric">Electric (EV)</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Transmission" class="form-label-custom"></label>
                    <select asp-for="Transmission" class="form-select-custom">
                        <option value="Automatic">Automatic</option>
                        <option value="Manual">Manual</option>
                        <option value="Dual-Clutch">Dual-Clutch / DSG</option>
                        <option value="eCVT">CVT / eCVT</option>
                    </select>
                </div>

                <div class="col-12 col-md-8">
                    <label asp-for="Vin" class="form-label-custom"></label>
                    <input asp-for="Vin" class="form-control-custom text-uppercase" />
                    <span asp-validation-for="Vin" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CurrentMileage" class="form-label-custom"></label>
                    <div class="input-group">
                        <input asp-for="CurrentMileage" type="number" class="form-control-custom" />
                        <span class="input-group-text border-0" style="background-color: var(--bg-surface); color: var(--text-muted);">km</span>
                    </div>
                    <span asp-validation-for="CurrentMileage" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <hr style="border-color: var(--border-subtle);" class="my-4" />

            <h5 class="text-info mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person-circle"></i>
                <span>Client & Billing Profile</span>
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="OwnerName" class="form-label-custom"></label>
                    <input asp-for="OwnerName" class="form-control-custom" />
                    <span asp-validation-for="OwnerName" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerPhone" class="form-label-custom"></label>
                    <input asp-for="OwnerPhone" class="form-control-custom" />
                    <span asp-validation-for="OwnerPhone" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerEmail" class="form-label-custom"></label>
                    <input asp-for="OwnerEmail" type="email" class="form-control-custom" />
                    <span asp-validation-for="OwnerEmail" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OwnerAddress" class="form-label-custom"></label>
                    <input asp-for="OwnerAddress" class="form-control-custom" />
                    <span asp-validation-for="OwnerAddress" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                <button type="button" class="btn-apex btn-apex-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash"></i>
                    <span>Delete</span>
                </button>

                <div class="d-flex gap-3">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-apex btn-apex-secondary">Cancel</a>
                    <button type="submit" class="btn-apex btn-apex-primary px-4">
                        <i class="bi bi-check-lg"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); color: #fff;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger d-flex align-items-center gap-2" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Confirm Vehicle Deletion</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p>Are you sure you want to delete vehicle <strong>@Model.LicensePlate</strong> (@Model.Make @Model.Model)?</p>
                <p class="text-muted" style="font-size: 13px;">This will remove the vehicle and associated appointments from the registry.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn-apex btn-apex-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-apex btn-apex-danger">
                        Confirm Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
