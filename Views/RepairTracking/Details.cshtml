@model web.net.Models.RepairJobCard
@{
    ViewData["Title"] = $"Job Card {Model.JobCardNumber}";
    int currentStepIndex = (int)Model.Status;
    var stages = new[] {
        ("Check-In", "bi-box-arrow-in-down"),
        ("Diagnostic", "bi-cpu"),
        ("In Progress", "bi-tools"),
        ("Waiting Parts", "bi-hourglass-split"),
        ("Quality Check", "bi-patch-check"),
        ("Ready", "bi-car-front"),
        ("Delivered", "bi-check2-circle")
    };
}

<div class="d-flex flex-column gap-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-secondary" style="font-size: 13px;">
                    <i class="bi bi-arrow-left me-1"></i> Repair Tracker
                </a>
                <span class="text-muted">/</span>
                <span class="text-muted" style="font-size: 13px;">Job Card Management</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-info" style="font-family: var(--font-mono); font-size: 26px;">
                    @Model.JobCardNumber
                </span>
                <span class="badge @Model.StatusBadgeClass fs-6 px-3 py-2">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (Model.Invoice != null)
            {
                <a asp-controller="Billing" asp-action="Details" asp-route-id="@Model.Invoice.Id" class="btn-apex btn-apex-success">
                    <i class="bi bi-receipt"></i>
                    <span>View Generated Invoice (@Model.Invoice.InvoiceNumber)</span>
                </a>
            }
            else
            {
                <form asp-controller="Billing" asp-action="GenerateFromJob" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                    <button type="submit" class="btn-apex btn-apex-success">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Generate Bill / Invoice</span>
                    </button>
                </form>
            }

            @if (Model.Status < web.net.Models.RepairStatus.Delivered)
            {
                <form asp-action="AdvanceStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-apex btn-apex-primary" title="Move to the next workflow stage">
                        <i class="bi bi-chevron-double-right"></i>
                        <span>Next Stage</span>
                    </button>
                </form>
            }

            <button type="button" class="btn-apex btn-apex-secondary" data-bs-toggle="modal" data-bs-target="#statusModal">
                <i class="bi bi-sliders"></i>
                <span>Set Status</span>
            </button>
        </div>
    </div>

    <!-- 7-Stage Visual Progress Stepper -->
    <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="fw-bold text-white fs-6 d-flex align-items-center gap-2">
                <i class="bi bi-activity text-info"></i>
                <span>Repair Workflow Telemetry</span>
            </div>
            <span class="text-secondary" style="font-size: 13px;">Overall Progress: <strong class="text-info">@Model.ProgressPercentage%</strong></span>
        </div>

        <div class="stepper-container">
            <div class="stepper-track">
                <div class="stepper-progress" style="width: @(Model.ProgressPercentage)%;"></div>
            </div>
            @for (int i = 0; i < stages.Length; i++)
            {
                var (title, icon) = stages[i];
                bool isCompleted = i < currentStepIndex;
                bool isActive = i == currentStepIndex;
                <div class="step-item @(isActive ? "active" : "") @(isCompleted ? "completed" : "")">
                    <div class="step-icon">
                        <i class="bi @(isCompleted ? "bi-check-lg" : icon)"></i>
                    </div>
                    <div class="step-title">@title</div>
                </div>
            }
        </div>

        <div class="row g-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.06) !important; font-size: 13px;">
            <div class="col-6 col-md-3">
                <span class="text-muted">Lead Technician:</span>
                <div class="fw-bold text-white">@(Model.LeadMechanic?.FullName ?? "Unassigned")</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Workshop Bay:</span>
                <div class="fw-bold text-info">@Model.Bay</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Started On:</span>
                <div class="text-white">@Model.StartedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Est. Completion:</span>
                <div class="text-white">@(Model.EstimatedCompletionAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "TBD")</div>
            </div>
        </div>
    </div>

    <!-- Vehicle & Customer Quick Header Bar -->
    <div class="glass-card p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="plate-tag accent fs-5">@Model.Vehicle?.LicensePlate</span>
                <div>
                    <div class="fw-bold text-white fs-6">@Model.Vehicle?.Year @Model.Vehicle?.Make @Model.Vehicle?.Model</div>
                    <div class="text-muted" style="font-size: 12px;">
                        Odometer In: <strong class="text-white">@Model.OdometerIn.ToString("N0") km</strong> &bull; Color: @Model.Vehicle?.Color &bull; VIN: @(Model.Vehicle?.Vin ?? "N/A")
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <div>
                    <div class="text-muted" style="font-size: 11px;">Client Name</div>
                    <div class="fw-semibold text-white">@Model.Vehicle?.OwnerName</div>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 11px;">Contact Phone</div>
                    <div class="fw-semibold text-white">@Model.Vehicle?.OwnerPhone</div>
                </div>
                <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn-apex btn-apex-secondary" style="padding: 6px 12px; font-size: 12px;">
                    Vehicle Profile
                </a>
            </div>
        </div>
    </div>

    <!-- Inspection Checklist & Diagnostic Findings -->
    <div class="row g-4">
        <!-- Multi-Point Inspection -->
        <div class="col-12 col-lg-6">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <div class="card-header-title">
                        <i class="bi bi-clipboard2-check text-success"></i>
                        <span>Multi-Point Digital Inspection</span>
                    </div>
                </div>
                <form asp-action="UpdateInspection" method="post" class="card-body-custom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkEngineOil">
                                <i class="bi bi-droplet me-2 text-warning"></i>Engine Oil & Filter Integrity
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkEngineOil" name="checkEngineOil" value="true" @(Model.CheckEngineOil ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkBrakeSystem">
                                <i class="bi bi-disc me-2 text-danger"></i>Brake Pads & Rotor Thickness
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkBrakeSystem" name="checkBrakeSystem" value="true" @(Model.CheckBrakeSystem ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkBatteryHealth">
                                <i class="bi bi-battery-charging me-2 text-info"></i>Battery Load & Cold Cranking Amps
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkBatteryHealth" name="checkBatteryHealth" value="true" @(Model.CheckBatteryHealth ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkTirePressureTread">
                                <i class="bi bi-vinyl me-2 text-secondary"></i>Tire Tread Depth & Pressure
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkTirePressureTread" name="checkTirePressureTread" value="true" @(Model.CheckTirePressureTread ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkCoolantRadiator">
                                <i class="bi bi-thermometer-half me-2 text-info"></i>Coolant & Radiator Pressure Test
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkCoolantRadiator" name="checkCoolantRadiator" value="true" @(Model.CheckCoolantRadiator ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkSuspensionSteering">
                                <i class="bi bi-gear me-2 text-warning"></i>Suspension Struts & Steering Rack
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkSuspensionSteering" name="checkSuspensionSteering" value="true" @(Model.CheckSuspensionSteering ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>

                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <label class="form-check-label text-white" for="checkLightsElectronics">
                                <i class="bi bi-lightbulb me-2 text-warning"></i>Headlamps, Indicators & Onboard ECU
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="checkLightsElectronics" name="checkLightsElectronics" value="true" @(Model.CheckLightsElectronics ? "checked" : "") style="width: 44px; height: 22px;">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Overall Inspection Grade:</label>
                        <select name="overallInspectionGrade" class="form-select-custom">
                            <option value="Pass - Good Condition" selected="@(Model.OverallInspectionGrade == "Pass - Good Condition")">Pass - Good Condition</option>
                            <option value="Attention Needed - Brake pads worn" selected="@(Model.OverallInspectionGrade.Contains("Brake"))">Attention Needed - Brake / Wear Items</option>
                            <option value="Maintenance Due" selected="@(Model.OverallInspectionGrade == "Maintenance Due")">Maintenance Due</option>
                            <option value="Critical Issue Detected" selected="@(Model.OverallInspectionGrade.Contains("Critical"))">Critical Safety Issue Detected</option>
                        </select>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn-apex btn-apex-primary" style="padding: 8px 16px; font-size: 13px;">
                            <i class="bi bi-check2"></i>
                            <span>Save Inspection</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Diagnostic Findings & Summary -->
        <div class="col-12 col-lg-6">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <div class="card-header-title">
                        <i class="bi bi-journal-text text-warning"></i>
                        <span>Technician Findings & Recommendations</span>
                    </div>
                </div>
                <form asp-action="UpdateNotes" method="post" class="card-body-custom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label-custom">Initial Diagnostic Telemetry & Customer Symptoms:</label>
                        <textarea name="diagnosticNotes" rows="4" class="form-control-custom" 
                                  placeholder="OBD-II error codes, visual wear findings, customer complaint verification...">@Model.DiagnosticNotes</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Work Performed / Technical Action Summary:</label>
                        <textarea name="workPerformedSummary" rows="4" class="form-control-custom" 
                                  placeholder="Procedures carried out, calibration notes, parts installed, torque specs...">@Model.WorkPerformedSummary</textarea>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn-apex btn-apex-primary" style="padding: 8px 16px; font-size: 13px;">
                            <i class="bi bi-save"></i>
                            <span>Save Notes</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Labor Line Items Section -->
    <div class="glass-card">
        <div class="card-header-custom">
            <div class="card-header-title">
                <i class="bi bi-person-gear text-primary"></i>
                <span>Labor & Service Charges (@Model.LaborItems.Count items)</span>
            </div>
            <button type="button" class="btn-apex btn-apex-primary" data-bs-toggle="modal" data-bs-target="#addLaborModal" style="padding: 6px 14px; font-size: 12px;">
                <i class="bi bi-plus-lg"></i>
                <span>Add Labor Task</span>
            </button>
        </div>
        <div class="p-0">
            @if (Model.LaborItems.Any())
            {
                <div class="table-responsive">
                    <table class="table-apex">
                        <thead>
                            <tr>
                                <th>Task Description</th>
                                <th class="text-center">Hours</th>
                                <th class="text-end">Rate / Hr</th>
                                <th class="text-end">Total</th>
                                <th class="text-end" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var labor in Model.LaborItems)
                            {
                                <tr>
                                    <td class="fw-semibold text-white">@labor.Description</td>
                                    <td class="text-center text-secondary">@labor.Hours.ToString("0.0") hrs</td>
                                    <td class="text-end text-muted">$@labor.HourlyRate.ToString("F2")</td>
                                    <td class="text-end fw-bold text-info">$@labor.LineTotal.ToString("F2")</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteLabor" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@labor.Id" />
                                            <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                                            <button type="submit" class="btn text-danger p-0 border-0" title="Remove" onclick="return confirm('Remove this labor task?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold text-secondary">Labor Subtotal:</td>
                                <td class="text-end fw-bold text-white fs-6">$@Model.TotalLaborCost.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No labor tasks recorded yet. Click "Add Labor Task" to record service hours.
                </div>
            }
        </div>
    </div>

    <!-- Replacement Spare Parts Requisition Section -->
    <div class="glass-card">
        <div class="card-header-custom">
            <div class="card-header-title">
                <i class="bi bi-box-seam text-info"></i>
                <span>Spare Parts & Consumables Requisition (@Model.PartItems.Count items)</span>
            </div>
            <button type="button" class="btn-apex btn-apex-primary" data-bs-toggle="modal" data-bs-target="#addPartModal" style="padding: 6px 14px; font-size: 12px;">
                <i class="bi bi-plus-lg"></i>
                <span>Add Spare Part</span>
            </button>
        </div>
        <div class="p-0">
            @if (Model.PartItems.Any())
            {
                <div class="table-responsive">
                    <table class="table-apex">
                        <thead>
                            <tr>
                                <th>Part Description</th>
                                <th>Part # / SKU</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Total</th>
                                <th class="text-end" style="width: 80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var part in Model.PartItems)
                            {
                                <tr>
                                    <td class="fw-semibold text-white">@part.PartName</td>
                                    <td>
                                        <span class="badge" style="background: rgba(255,255,255,0.06); font-family: var(--font-mono); font-size: 11px;">
                                            @(part.PartNumber ?? "OEM-STANDARD")
                                        </span>
                                    </td>
                                    <td class="text-center text-secondary">@part.Quantity</td>
                                    <td class="text-end text-muted">$@part.UnitPrice.ToString("F2")</td>
                                    <td class="text-end fw-bold text-info">$@part.LineTotal.ToString("F2")</td>
                                    <td class="text-end">
                                        <form asp-action="DeletePart" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@part.Id" />
                                            <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                                            <button type="submit" class="btn text-danger p-0 border-0" title="Remove" onclick="return confirm('Remove this part?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-secondary">Parts Subtotal:</td>
                                <td class="text-end fw-bold text-white fs-6">$@Model.TotalPartsCost.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No replacement parts added yet. Click "Add Spare Part" to record installed components.
                </div>
            }
        </div>
    </div>

    <!-- Live Cost Calculation & Invoice Generation Bar -->
    <div class="glass-card p-4" style="background: linear-gradient(145deg, #162033, #151e30); border-color: rgba(14, 165, 233, 0.3);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div>
                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 11px;">
                    FINANCIAL SUMMARY
                </span>
                <div class="d-flex align-items-baseline gap-3 mt-1">
                    <span class="text-secondary" style="font-size: 14px;">Estimated Total Cost:</span>
                    <span class="fw-bold text-white fs-3">$@Model.EstimatedTotalCost.ToString("N2")</span>
                </div>
                <div class="text-muted" style="font-size: 12px;">
                    Labor Charges: <strong class="text-white">${Model.TotalLaborCost.ToString("F2")}</strong> &bull; 
                    Parts & Materials: <strong class="text-white">${Model.TotalPartsCost.ToString("F2")}</strong>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                @if (Model.Invoice != null)
                {
                    <a asp-controller="Billing" asp-action="Details" asp-route-id="@Model.Invoice.Id" class="btn-apex btn-apex-primary">
                        <i class="bi bi-receipt"></i>
                        <span>Open Invoice (@Model.Invoice.InvoiceNumber)</span>
                    </a>
                }
                else
                {
                    <form asp-controller="Billing" asp-action="GenerateFromJob" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                        <button type="submit" class="btn-apex btn-apex-success px-4 py-2 fs-6">
                            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                            <span>Generate Customer Bill & Invoice</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Set Status Directly -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); color: #fff;">
            <div class="modal-header border-bottom border-secondary pb-3">
                <h5 class="modal-title" id="statusModalLabel">
                    <i class="bi bi-sliders text-info me-2"></i>Set Repair Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SetStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body py-4">
                    <label class="form-label-custom">Select New Workshop Stage:</label>
                    <select name="status" class="form-select-custom">
                        <option value="PendingCheckIn" selected="@(Model.Status == web.net.Models.RepairStatus.PendingCheckIn)">Pending Check-In</option>
                        <option value="InspectionDiagnostic" selected="@(Model.Status == web.net.Models.RepairStatus.InspectionDiagnostic)">Inspection & Diagnostics</option>
                        <option value="InProgress" selected="@(Model.Status == web.net.Models.RepairStatus.InProgress)">In Progress (Mechanical Work)</option>
                        <option value="WaitingParts" selected="@(Model.Status == web.net.Models.RepairStatus.WaitingParts)">Waiting for Parts</option>
                        <option value="QualityCheck" selected="@(Model.Status == web.net.Models.RepairStatus.QualityCheck)">Quality Testing & Road Audit</option>
                        <option value="ReadyForDelivery" selected="@(Model.Status == web.net.Models.RepairStatus.ReadyForDelivery)">Ready for Delivery</option>
                        <option value="Delivered" selected="@(Model.Status == web.net.Models.RepairStatus.Delivered)">Delivered & Closed</option>
                    </select>
                </div>
                <div class="modal-footer border-top border-secondary pt-3">
                    <button type="button" class="btn-apex btn-apex-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-apex btn-apex-primary">Apply Stage</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Labor Item -->
<div class="modal fade" id="addLaborModal" tabindex="-1" aria-labelledby="addLaborModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); color: #fff;">
            <div class="modal-header border-bottom border-secondary pb-3">
                <h5 class="modal-title" id="addLaborModalLabel">
                    <i class="bi bi-person-gear text-primary me-2"></i>Add Labor Task
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddLabor" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                <div class="modal-body py-4 d-flex flex-column gap-3">
                    <div>
                        <label class="form-label-custom">Task Description:</label>
                        <input type="text" name="description" class="form-control-custom" placeholder="e.g. Front brake disc resurfacing and pad installation" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label-custom">Hours:</label>
                            <input type="number" step="0.1" name="hours" class="form-control-custom" value="1.0" min="0.1" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label-custom">Hourly Rate ($):</label>
                            <input type="number" step="0.01" name="hourlyRate" class="form-control-custom" value="85.00" min="0" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary pt-3">
                    <button type="button" class="btn-apex btn-apex-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-apex btn-apex-primary">Add Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Spare Part Item -->
<div class="modal fade" id="addPartModal" tabindex="-1" aria-labelledby="addPartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle); color: #fff;">
            <div class="modal-header border-bottom border-secondary pb-3">
                <h5 class="modal-title" id="addPartModalLabel">
                    <i class="bi bi-box-seam text-info me-2"></i>Add Replacement Spare Part
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddPart" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="repairJobCardId" value="@Model.Id" />
                <div class="modal-body py-4 d-flex flex-column gap-3">
                    <div>
                        <label class="form-label-custom">Part Name / Description:</label>
                        <input type="text" name="partName" class="form-control-custom" placeholder="e.g. Brembo Ceramic Front Brake Pads" required />
                    </div>
                    <div>
                        <label class="form-label-custom">Part Number / SKU (Optional):</label>
                        <input type="text" name="partNumber" class="form-control-custom text-uppercase" placeholder="e.g. BRM-P85075" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label-custom">Quantity:</label>
                            <input type="number" name="quantity" class="form-control-custom" value="1" min="1" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label-custom">Unit Price ($):</label>
                            <input type="number" step="0.01" name="unitPrice" class="form-control-custom" placeholder="0.00" min="0" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary pt-3">
                    <button type="button" class="btn-apex btn-apex-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-apex btn-apex-primary">Add Part</button>
                </div>
            </form>
        </div>
    </div>
</div>
