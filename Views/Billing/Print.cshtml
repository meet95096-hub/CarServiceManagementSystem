@model web.net.Models.Invoice
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @Model.InvoiceNumber - ApexAuto Dynamics</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 40px 20px;
            margin: 0;
        }

        .invoice-paper {
            max-width: 850px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 48px;
            border: 1px solid #e2e8f0;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        .table th {
            background-color: #f8fafc;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
            padding: 10px 14px;
        }

        .table td {
            padding: 12px 14px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 13px;
            vertical-align: middle;
        }

        .btn-print {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            gap: 10px;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .invoice-paper {
                box-shadow: none;
                border: none;
                padding: 0;
                max-width: 100%;
            }
            .btn-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Floating Action Toolbar -->
    <div class="btn-print">
        <button onclick="window.print()" class="btn btn-primary shadow d-flex align-items-center gap-2">
            <i class="bi bi-printer-fill"></i>
            <span>Print Invoice</span>
        </button>
        <button onclick="window.close()" class="btn btn-secondary shadow">
            Close
        </button>
    </div>

    <!-- Printable Paper Sheet -->
    <div class="invoice-paper">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start pb-4 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 40px; height: 40px; background: #0f172a; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px;">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold" style="letter-spacing: -0.5px; color: #0f172a;">APEXAUTO DYNAMICS</h3>
                        <div class="text-muted" style="font-size: 11px; font-weight: 600; letter-spacing: 1px;">CAR SERVICE & PERFORMANCE CENTER</div>
                    </div>
                </div>
                <div class="text-secondary mt-3" style="font-size: 12px; line-height: 1.5;">
                    100 Performance Way, Motor Speedway District<br />
                    Phone: +1 (800) 555-APEX &bull; Email: billing@apexautoworks.com<br />
                    Business Tax ID: US-89410294-TX
                </div>
            </div>

            <div class="text-end">
                <span class="badge @(Model.Status == web.net.Models.InvoiceStatus.Paid ? "bg-success" : "bg-danger") px-3 py-2 mb-2" style="font-size: 12px; letter-spacing: 1px;">
                    @Model.Status.ToString().ToUpper()
                </span>
                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Tax Invoice Number</div>
                <div class="fw-bold fs-5 font-mono text-primary">@Model.InvoiceNumber</div>
                <div class="text-muted mt-2" style="font-size: 11px; text-transform: uppercase;">Issue Date: <strong>@Model.InvoiceDate.ToString("MMM dd, yyyy")</strong></div>
                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Payment Due: <strong>@Model.DueDate.ToString("MMM dd, yyyy")</strong></div>
            </div>
        </div>

        <!-- Client & Vehicle Details -->
        <div class="row g-4 py-4 border-bottom">
            <div class="col-6">
                <div class="text-muted mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Billed Client:</div>
                <div class="fw-bold fs-6 text-dark">@Model.Vehicle?.OwnerName</div>
                <div class="text-secondary" style="font-size: 12px; line-height: 1.5;">
                    <div>Phone: @Model.Vehicle?.OwnerPhone</div>
                    @if (!string.IsNullOrEmpty(Model.Vehicle?.OwnerEmail))
                    {
                        <div>Email: @Model.Vehicle?.OwnerEmail</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Vehicle?.OwnerAddress))
                    {
                        <div>Address: @Model.Vehicle?.OwnerAddress</div>
                    }
                </div>
            </div>

            <div class="col-6">
                <div class="text-muted mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Vehicle & Job Details:</div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="font-mono fw-bold px-2 py-1 rounded" style="background: #e2e8f0; font-size: 12px;">@Model.Vehicle?.LicensePlate</span>
                    <span class="fw-bold text-dark">@Model.Vehicle?.Year @Model.Vehicle?.Make @Model.Vehicle?.Model</span>
                </div>
                <div class="text-secondary" style="font-size: 12px; line-height: 1.5;">
                    <div>VIN: <span class="font-mono">@(Model.Vehicle?.Vin ?? "N/A")</span></div>
                    <div>Repair Job Card: <span class="font-mono">@Model.RepairJobCard?.JobCardNumber</span></div>
                    <div>Assigned Lead: @(Model.RepairJobCard?.LeadMechanic?.FullName ?? "Workshop Master Tech") (@(Model.RepairJobCard?.Bay ?? "Bay 1"))</div>
                </div>
            </div>
        </div>

        <!-- Labor Table -->
        <div class="py-3">
            <div class="fw-bold text-dark mb-2" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                1. Mechanical Labor & Technical Diagnostic Services
            </div>
            @if (Model.RepairJobCard?.LaborItems != null && Model.RepairJobCard.LaborItems.Any())
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Task Description</th>
                            <th class="text-center" style="width: 100px;">Hours</th>
                            <th class="text-end" style="width: 120px;">Rate / Hr</th>
                            <th class="text-end" style="width: 130px;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var labor in Model.RepairJobCard.LaborItems)
                        {
                            <tr>
                                <td>@labor.Description</td>
                                <td class="text-center">@labor.Hours.ToString("0.0")</td>
                                <td class="text-end">$@labor.HourlyRate.ToString("F2")</td>
                                <td class="text-end fw-semibold">$@labor.LineTotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Parts Table -->
        <div class="py-3">
            <div class="fw-bold text-dark mb-2" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                2. Replacement Spare Parts & Workshop Consumables
            </div>
            @if (Model.RepairJobCard?.PartItems != null && Model.RepairJobCard.PartItems.Any())
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Part Name / Description</th>
                            <th style="width: 140px;">Part # / SKU</th>
                            <th class="text-center" style="width: 70px;">Qty</th>
                            <th class="text-end" style="width: 110px;">Unit Price</th>
                            <th class="text-end" style="width: 130px;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in Model.RepairJobCard.PartItems)
                        {
                            <tr>
                                <td>@part.PartName</td>
                                <td class="font-mono text-muted" style="font-size: 11px;">@(part.PartNumber ?? "OEM")</td>
                                <td class="text-center">@part.Quantity</td>
                                <td class="text-end">$@part.UnitPrice.ToString("F2")</td>
                                <td class="text-end fw-semibold">$@part.LineTotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Totals Calculation -->
        <div class="row justify-content-end py-3 border-top mt-2">
            <div class="col-6">
                <div class="d-flex flex-column gap-1" style="font-size: 13px;">
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Labor Subtotal:</span>
                        <span class="text-dark fw-semibold">$@Model.LaborTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Parts Subtotal:</span>
                        <span class="text-dark fw-semibold">$@Model.PartsTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary border-top pt-1">
                        <span>Net Subtotal:</span>
                        <span class="text-dark fw-bold">$@Model.SubTotal.ToString("N2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success">
                            <span>Discount (@Model.DiscountPercentage%):</span>
                            <span>-$@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Sales Tax / GST (@Model.TaxRate%):</span>
                        <span class="text-dark fw-semibold">$@Model.TaxAmount.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-1">
                        <span class="fw-bold fs-6 text-dark">Grand Total:</span>
                        <span class="fw-bold fs-5 text-dark font-mono">$@Model.GrandTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between text-success pt-1">
                        <span>Amount Paid:</span>
                        <span class="fw-bold">$@Model.AmountPaid.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-1">
                        <span class="fw-bold @(Model.BalanceDue > 0 ? "text-danger" : "text-muted")">Balance Due:</span>
                        <span class="fw-bold fs-6 font-mono @(Model.BalanceDue > 0 ? "text-danger" : "text-success")">
                            $@Model.BalanceDue.ToString("N2")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Settlement & Terms -->
        <div class="mt-3 p-3 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0; font-size: 12px;">
            @if (Model.Status == web.net.Models.InvoiceStatus.Paid || Model.Status == web.net.Models.InvoiceStatus.PartiallyPaid)
            {
                <div class="mb-2 pb-2 border-bottom text-success fw-bold">
                    <i class="bi bi-check-circle-fill me-1"></i>Settlement Verified: @Model.PaymentMethod &bull; Ref: @(Model.TransactionReference ?? "TXN-AUTO") &bull; Date: @(Model.PaidAt?.ToString("MMM dd, yyyy") ?? "Completed")
                </div>
            }
            <div class="text-muted">
                <strong>Warranty & Service Guarantee:</strong> @Model.Notes
            </div>
        </div>

        <!-- Signature Lines -->
        <div class="row pt-5 mt-4 text-center" style="font-size: 12px;">
            <div class="col-6">
                <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto; padding-top: 6px;">
                    <strong>Customer Authorization & Acceptance</strong>
                </div>
            </div>
            <div class="col-6">
                <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto; padding-top: 6px;">
                    <strong>Certified Service Director & Stamp</strong>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
