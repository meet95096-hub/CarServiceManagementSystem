@model IEnumerable<web.net.Models.Invoice>
@{
    ViewData["Title"] = "Invoices & Billing";
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="mb-1" style="font-size: 26px; font-weight: 800;">Invoices & Billing</h1>
            <p class="text-secondary mb-0" style="font-size: 14px;">Manage itemized repair bills, track payments, generate print statements, and review collections.</p>
        </div>
    </div>

    <!-- 4 Financial Stat Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Total Billed Volume</div>
                    <div class="stat-value">$@ViewBag.TotalBilled.ToString("N2")</div>
                    <div class="stat-meta">Lifetime repair invoices</div>
                </div>
                <div class="stat-icon blue"><i class="bi bi-receipt"></i></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Cash & Card Collected</div>
                    <div class="stat-value text-success">$@ViewBag.TotalCollected.ToString("N2")</div>
                    <div class="stat-meta">Settled transactions</div>
                </div>
                <div class="stat-icon green"><i class="bi bi-wallet2"></i></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Outstanding Receivables</div>
                    <div class="stat-value text-danger">$@ViewBag.TotalUnpaid.ToString("N2")</div>
                    <div class="stat-meta">Pending customer balance</div>
                </div>
                <div class="stat-icon amber"><i class="bi bi-hourglass-bottom"></i></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Unpaid Invoices</div>
                    <div class="stat-value">@ViewBag.UnpaidCount</div>
                    <div class="stat-meta">Awaiting payment settlement</div>
                </div>
                <div class="stat-icon purple"><i class="bi bi-exclamation-circle"></i></div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="glass-card p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text border-0" style="background-color: var(--bg-surface); color: var(--text-muted);">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" 
                           class="form-control-custom border-start-0" 
                           placeholder="Search by invoice #, license plate, customer, or job #..." />
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="status" class="form-select-custom">
                    <option value="">All Payment Statuses</option>
                    <option value="Unpaid" selected="@(ViewBag.SelectedStatus?.ToString() == "Unpaid")">Unpaid</option>
                    <option value="PartiallyPaid" selected="@(ViewBag.SelectedStatus?.ToString() == "PartiallyPaid")">Partially Paid</option>
                    <option value="Paid" selected="@(ViewBag.SelectedStatus?.ToString() == "Paid")">Paid (Settled)</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus?.ToString() == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn-apex btn-apex-primary w-100 justify-content-center">
                    Filter
                </button>
                @if (ViewBag.SelectedStatus != null || !string.IsNullOrEmpty(ViewBag.Search))
                {
                    <a asp-action="Index" class="btn-apex btn-apex-secondary" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Invoices List Table -->
    <div class="glass-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table-apex">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Vehicle & Client</th>
                            <th>Job Card Ref</th>
                            <th>Grand Total</th>
                            <th>Amount Paid</th>
                            <th>Balance Due</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-info" style="font-family: var(--font-mono); font-size: 13px;">
                                        @inv.InvoiceNumber
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        @inv.InvoiceDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="plate-tag" style="font-size: 11px; padding: 2px 6px;">@inv.Vehicle?.LicensePlate</span>
                                        <span class="text-white fw-semibold" style="font-size: 13px;">@inv.Vehicle?.OwnerName</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        @inv.Vehicle?.Make @inv.Vehicle?.Model
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="RepairTracking" asp-action="Details" asp-route-id="@inv.RepairJobCardId" 
                                       class="text-decoration-none text-info font-monospace" style="font-size: 12px;">
                                        @inv.RepairJobCard?.JobCardNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold text-white fs-6">$@inv.GrandTotal.ToString("N2")</div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        Labor: $@inv.LaborTotal.ToString("N0") | Parts: $@inv.PartsTotal.ToString("N0")
                                    </div>
                                </td>
                                <td>
                                    <div class="text-success fw-semibold">$@inv.AmountPaid.ToString("N2")</div>
                                    @if (!string.IsNullOrEmpty(inv.PaymentMethod))
                                    {
                                        <div class="text-muted text-truncate" style="font-size: 10px; max-width: 140px;">
                                            @inv.PaymentMethod
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="@(inv.BalanceDue > 0 ? "text-danger fw-bold" : "text-muted")">
                                        $@inv.BalanceDue.ToString("N2")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(inv.Status == InvoiceStatus.Paid ? "bg-success" : inv.Status == InvoiceStatus.PartiallyPaid ? "bg-warning text-dark" : "bg-danger")">
                                        @inv.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <a asp-action="Details" asp-route-id="@inv.Id" class="btn-apex btn-apex-secondary" style="padding: 5px 10px; font-size: 11px;">
                                            <span>Manage</span>
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                        <a asp-action="Print" asp-route-id="@inv.Id" target="_blank" class="btn-apex btn-apex-primary" style="padding: 5px 10px; font-size: 11px;" title="Print / PDF Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-receipt-cutoff fs-1 d-block mb-3 text-secondary"></i>
                <div class="fs-5 fw-bold text-white">No invoices found</div>
                <p class="text-secondary mb-0">No invoice records correspond to your query.</p>
            </div>
        }
    </div>
</div>
